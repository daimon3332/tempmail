# ---- required ----
DOMAINS=["daimon.dpdns.org","333186.xyz","mail.daimon.dpdns.org","edu.daimon.dpdns.org","ooad.dpdns.org","edu.ooad.dpdns.org","mail.ooad.dpdns.org"]
ADMIN_PASSWORDS=["change-me"]
JWT_SECRET=change-me-long-random

# ---- frontend (user sets up nginx for tempmail.333186.xyz) ----
FRONTEND_URL=https://tempmail.333186.xyz
TITLE=Temp Email
PREFIX=orx
DEFAULT_LANG=zh
SMTP_HOSTNAME=mail.daimon.dpdns.org
TRUSTED_PROXIES=*

