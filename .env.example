# ---- required ----
DOMAINS=["daimon.dpdns.org","333186.xyz","mail.daimon.dpdns.org","edu.daimon.dpdns.org","ooad.dpdns.org","edu.ooad.dpdns.org","mail.ooad.dpdns.org"]
ADMIN_PASSWORDS=["change-me"]
JWT_SECRET=change-me-long-random

# ---- optional (same names/semantics as cloudflare_temp_email) ----
TITLE=Temp Email
PREFIX=orx
DEFAULT_LANG=zh
FRONTEND_URL=https://tempmail.daimon.dpdns.org
SMTP_HOSTNAME=mail.daimon.dpdns.org
#PASSWORDS=["site-password"]
#DEFAULT_DOMAINS=["333186.xyz"]
#RANDOM_SUBDOMAIN_DOMAINS=["333186.xyz"]
#MIN_ADDRESS_LEN=1
#MAX_ADDRESS_LEN=30
ENABLE_USER_CREATE_EMAIL=true
ENABLE_USER_DELETE_EMAIL=true
ENABLE_MAIL_READ_STATUS=true
#DISABLE_ANONYMOUS_USER_CREATE_EMAIL=false
#ENABLE_ADDRESS_PASSWORD=false
#ENABLE_WEBHOOK=false
#ENABLE_AUTO_REPLY=false
#ENABLE_CHECK_JUNK_MAIL=false
#BLOCK_UNKNOWN_ADDRESS=false
#FORWARD_ADDRESS_LIST=["me@example.com"]

# roles: env-defined (DB-defined roles via POST /admin/roles also work)
#USER_ROLES=[{"role":"vip","domains":["333186.xyz"],"prefix":""}]
#ADMIN_USER_ROLE=admin
#USER_DEFAULT_ROLE=
#NO_LIMIT_SEND_ROLE=vip

# outbound mail: per-domain SMTP relay, "*" as fallback. Without it, mail is
# delivered directly to the recipient MX (needs outbound port 25).
#SMTP_CONFIG={"*":{"host":"smtp.example.com","port":587,"username":"u","password":"p","secure":false}}
#DEFAULT_SEND_BALANCE=0

# trust CF-Connecting-IP / X-Forwarded-For from these proxy IPs ("*" = any)
TRUSTED_PROXIES=*
ORIGIN_URL=http://example.com.nip.io
#ORIGIN_TOKEN=required-when-fronted-by-the-proxy-worker
#INGEST_TOKEN=shared-with-the-ingest-worker
